# All frontend env vars are PUBLIC (NEXT_PUBLIC_*) or build-time config.
# API keys never go here — they live only on the backend (Railway).

# Production backend (Railway). Leave BOTH unset for local dev — URLs are
# derived from the page hostname (ws://<host>:3001/ws), which keeps the
# two-laptop LAN setup working with zero config.
# NEXT_PUBLIC_BACKEND_WS_URL=wss://api.tryshema.app/ws
# NEXT_PUBLIC_BACKEND_HTTP_URL=https://api.tryshema.app

# Origin of the contact-form Cloudflare Worker (see ../marketing-worker).
# Set on Vercel to the Worker's OWN origin (its *.workers.dev URL) — NOT
# https://tryshema.app (that's Vercel itself → infinite rewrite loop) and NOT
# api.tryshema.app (that's the Railway backend). Unset in dev: form won't send.
# CONTACT_WORKER_ORIGIN=https://shema-contact.your-account.workers.dev
