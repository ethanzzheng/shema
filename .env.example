# ─── Backend API Keys ─────────────────────────────────────────────────────────
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Get your key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=...

# Voice ID to use for English TTS output.
# Find IDs at: https://elevenlabs.io/app/voice-library
# Example: Adam (pre-made) = pNInz6obpgDQGcFmaJgB
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Backend server port
PORT=3001

# Frontend URL (used for CORS in production; leave * for local dev)
FRONTEND_URL=*

# ─── Frontend (Next.js public vars) ───────────────────────────────────────────
# Set these in frontend/.env.local (or platform env vars for deployment)
# For local development these default to localhost:3001 in next.config.js

# NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:3001/ws
# NEXT_PUBLIC_BACKEND_HTTP_URL=http://localhost:3001

# For Railway/production deployment (replace with your Railway URL):
# NEXT_PUBLIC_BACKEND_WS_URL=wss://your-backend.railway.app/ws
# NEXT_PUBLIC_BACKEND_HTTP_URL=https://your-backend.railway.app
