# ── Required API keys (NEVER commit real values; on Railway set these in the dashboard) ──
ANTHROPIC_API_KEY=sk-ant-your-key-here
DEEPGRAM_API_KEY=your-deepgram-key-here
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# ── TTS voices (per translation direction) ──────────────────────────────────
# English voice, used by ko-en (Korean sermon → English audio). The legacy
# ELEVENLABS_VOICE_ID name still works and means the same thing — set either.
ELEVENLABS_VOICE_ID=your-voice-id-here
# ELEVENLABS_VOICE_ID_EN=your-english-voice-id

# Korean voice, used by en-ko (English sermon → Korean audio). No fallback to
# the English voice — en-ko broadcasts refuse to start until this is set.
# Pick a Korean-capable voice from https://elevenlabs.io/app/voice-library.
# ELEVENLABS_VOICE_ID_KO=your-korean-voice-id

# ── Server ──────────────────────────────────────────────────────────────────
# Local dev port. Railway injects its own PORT — do not set it there.
PORT=3001

# Production only: comma-separated browser origins allowed for CORS + WebSocket
# connections. Leave unset in dev (everything allowed).
# FRONTEND_URL=https://tryshema.app,https://www.tryshema.app

# ── Staff login (Phase A — env-config users, no database) ───────────────────
# POST /login checks these and returns a 12h session JWT; starting a broadcast
# requires that token. Listeners never need auth. Leave BOTH unset in dev
# (broadcasting stays open). Real accounts + DB are Phase B.
#
# AUTH_USERS is a JSON map of username → bcrypt password hash. Generate a hash:
#   cd backend && node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# AUTH_USERS={"hanmaum":"$2b$10$VHsOwM8xcwTksV8nzda8FeU1jsFct1woDOR/rA2wBzysXCEfSOS26"}
#
# AUTH_SECRET signs the session tokens — any long random string:
#   openssl rand -hex 32
# AUTH_SECRET=pick-a-long-random-string

# ── Optional tuning ─────────────────────────────────────────────────────────
# Per-sermon STT vocabulary biasing (comma-separated Korean keyterms).
# DEEPGRAM_KEYTERMS=예수님,하나님,목자님

# TTS model override for the ENGLISH voice (default: eleven_turbo_v2_5).
# TTS_MODEL=eleven_flash_v2_5

# TTS model override for the KOREAN voice (en-ko direction), independent of
# TTS_MODEL so the two can be A/B tested separately.
# TTS_MODEL_KO=eleven_multilingual_v2

# TTS voice delivery (ear-tunable; defaults chosen for steady clip-to-clip
# loudness). Lower stability / higher style = more expressive but the volume
# swings more between sentences.
# TTS_STABILITY=0.5
# TTS_STYLE=0

# TTS speaking rate (~0.7-1.2; unset = model default). Korean renderings often
# run longer than the English they translate, so a slight en-ko speed-up
# (e.g. 1.1) reduces how far audio drifts behind live speech. TTS_SPEED_KO
# applies to the Korean voice only, falling back to TTS_SPEED (both voices).
# TTS_SPEED=1
# TTS_SPEED_KO=1.1

# Per-church proper nouns as "한국어=English" pairs, comma-separated. Appended
# to the system prompt (so it rides the prompt cache) and used to keep ONE
# spelling all service — the live bug was "Han Ma Eum" in one service and
# "Hanmaeum" in the next, for the same church. Member names belong here too:
# a garbled name during a welcome is heard by exactly the person being welcomed.
# Quote the whole value; the renderings contain spaces.
#
# Recognition is biased separately by the DEFAULT_KEYTERMS list in src/stt.ts.
# DEEPGRAM_KEYTERMS REPLACES that list wholesale rather than adding to it, so
# leave it unset unless you intend to supply the full vocabulary yourself.
CHURCH_GLOSSARY="한마음교회=Hanmaum Church,한마음=Hanmaum,목장=Mokjang"
