{
  "name": "jc-translate-backend",
  "version": "1.0.0",
  "description": "Korean sermon → English translation backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "eval": "tsx evals/run.ts",
    "eval:en-ko": "tsx evals/run-en-ko.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.5",
    "typescript": "^5.4.5"
  }
}
